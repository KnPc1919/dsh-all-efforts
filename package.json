    "deepseek",
    "reasoning-effort"
  ],
  "license": "MIT",
  "author": "KnPc1919",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnPc1919/dsh-all-efforts.git"
  },
  "homepage": "https://github.com/KnPc1919/dsh-all-efforts#readme",
  "bugs": {
    "url": "https://github.com/KnPc1919/dsh-all-efforts/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
